/* Global Styles - Classic & Professional */
:root {
    --primary-color: #2c3e50;
    /* Deep Slate Blue - Serious, Trustworthy */
    --secondary-color: #ecf0f1;
    /* very light gray for backgrounds */
    --accent-color: #8e44ad;
    /* Removed (or kept very subtle if needed), let's use a gold/bronze for engineering or just blue-grey */
    --accent-color-2: #c0392b;
    /* Subtle red for errors or call to action if needed, but keeping it minimal */
    --link-color: #2980b9;

    --text-dark: #333333;
    --text-medium: #555555;
    --text-light: #999999;

    --bg-white: #ffffff;
    --bg-light: #f8f9fa;
    /* Very clean light gray */

    --max-width: 1100px;
    /* Slightly tighter container for classic read */

    --font-heading: 'Playfair Display', serif;
    /* Classic Serif for headings */
    --font-body: 'Lato', sans-serif;
    /* Clean Sans-Serif for readability */
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: var(--font-body);
    line-height: 1.6;
    color: var(--text-dark);
    background-color: var(--bg-white);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    font-size: 16px;
}

h1,
h2,
h3,
h4,
h5,
h6 {
    font-family: var(--font-heading);
    font-weight: 400;
    /* Regular weight looks more elegant in Serif */
    margin-bottom: 1rem;
    color: var(--primary-color);
    letter-spacing: 0.5px;
}

a {
    text-decoration: none;
    color: var(--link-color);
    transition: color 0.2s ease;
}

a:hover {
    color: var(--primary-color);
    text-decoration: underline;
}

ul {
    list-style: none;
}

img {
    max-width: 100%;
    height: auto;
    display: block;
}

.container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 30px;
}

.section {
    padding: 80px 0;
    border-bottom: 1px solid #eeeeee;
}

.section:last-child {
    border-bottom: none;
}

.text-center {
    text-align: center;
}

.mt-2 {
    margin-top: 2rem;
}

/* Buttons - Classic Style */
.btn {
    display: inline-block;
    background-color: var(--primary-color);
    color: var(--bg-white);
    padding: 14px 35px;
    border-radius: 2px;
    /* Square/Sharp corners */
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.9rem;
    letter-spacing: 2px;
    border: 1px solid var(--primary-color);
    transition: all 0.3s ease;
    text-decoration: none;
}

.btn:hover {
    background-color: transparent;
    color: var(--primary-color);
    text-decoration: none;
}

.btn-outline {
    display: inline-block;
    border: 1px solid var(--primary-color);
    color: var(--primary-color);
    padding: 12px 30px;
    border-radius: 2px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    text-decoration: none;
}

.btn-outline:hover {
    background-color: var(--primary-color);
    color: var(--bg-white);
    text-decoration: none;
}

.btn-sm {
    padding: 5px 15px;
    background: #f0f0f0;
    color: #333;
    border: 1px solid #ddd;
    border-radius: 2px;
    font-size: 0.75rem;
    text-transform: uppercase;
}

/* Header - Minimal & Clean */
.header {
    background-color: var(--bg-white);
    border-bottom: 1px solid #e0e0e0;
    position: sticky;
    top: 0;
    z-index: 1000;
    overflow: visible;
    /* Allow logo to hang out */
}

.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 130px;
    /* Increased to accommodate larger logo inside */
}

.logo-link {
    display: flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
    background: none;
    box-shadow: none;
    padding: 0;
    position: static;
    /* Reset positioning */
}

.logo-img {
    height: 110px;
    /* Big and clear, contained in header */
    width: auto;
    display: block;
}

.logo-text {
    display: none;
}

.nav-links {
    display: flex;
    gap: 40px;
}

.nav-links a {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.95rem;
    color: var(--text-dark);
    text-transform: uppercase;
    letter-spacing: 1px;
    padding-bottom: 5px;
    border-bottom: 2px solid transparent;
}

.nav-links a:hover {
    color: var(--primary-color);
    border-bottom: 2px solid var(--primary-color);
    text-decoration: none;
}

/* Hero - Subtle */
.hero {
    height: 500px;
    background-color: #dcdcdc;
    /* Fallback */
    /* Use a more architectural/black and white or desaturated image */
    background-image: linear-gradient(rgba(44, 62, 80, 0.7), rgba(44, 62, 80, 0.7)), url('https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80');
    background-size: cover;
    background-position: center;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--bg-white);
}

.hero-content h1 {
    font-size: 3.5rem;
    margin-bottom: 20px;
    color: var(--bg-white);
    font-family: var(--font-heading);
    font-weight: 300;
    letter-spacing: 3px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
    padding-bottom: 20px;
    display: inline-block;
}

.hero-content p {
    font-size: 1.1rem;
    margin-bottom: 40px;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    font-weight: 300;
    letter-spacing: 1px;
}

/* Services - Clean Columns */
.section-title {
    text-align: center;
    font-size: 2.2rem;
    margin-bottom: 60px;
    position: relative;
    padding-bottom: 20px;
}

.section-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    background-color: var(--primary-color);
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
}

.service-card {
    background: var(--bg-white);
    padding: 40px 20px;
    text-align: center;
    border: 1px solid #eeeeee;
    transition: box-shadow 0.3s ease;
}

.service-card:hover {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
}

.service-card i {
    font-size: 2.5rem;
    color: var(--primary-color);
    margin-bottom: 25px;
    opacity: 0.8;
}

.service-card h3 {
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 15px;
}

.service-card p {
    color: var(--text-medium);
    font-size: 0.95rem;
    line-height: 1.7;
}

/* Projects Grid - Gallery Style */
.projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 40px;
    margin-top: 40px;
}

.project-card {
    background: var(--bg-white);
    border: 1px solid #eaeaea;
    transition: transform 0.2s ease;
}

.project-card:hover {
    border-color: var(--primary-color);
}

.project-image {
    height: 240px;
    overflow: hidden;
    position: relative;
}

.project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(10%);
    /* Slight desaturation for elegance */
    transition: filter 0.3s, transform 0.3s;
}

.project-card:hover .project-image img {
    filter: grayscale(0%);
    transform: scale(1.05);
}

.project-info {
    padding: 25px;
    text-align: left;
}

.category-tag {
    font-size: 0.7rem;
    color: var(--text-light);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    display: block;
    margin-bottom: 10px;
}

.project-info h3 {
    font-size: 1.4rem;
    margin-bottom: 10px;
    color: var(--text-dark);
}

.project-info p {
    font-size: 0.9rem;
    color: var(--text-medium);
    margin-bottom: 20px;
}

.read-more {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 700;
    color: var(--primary-color);
    text-decoration: none;
}

/* Filters */
.filters {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-bottom: 50px;
}

.filter-btn {
    padding: 8px 16px;
    background: transparent;
    border: 1px solid #ddd;
    color: var(--text-medium);
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.2s;
}

.filter-btn:hover,
.filter-btn.active {
    border-color: var(--primary-color);
    color: var(--primary-color);
    text-decoration: none;
}


/* Project Detail Pages */
.project-detail-header {
    background-color: var(--bg-light);
    padding: 60px 0;
    text-align: center;
    border-bottom: 1px solid #e5e5e5;
}

.category-pill {
    display: inline-block;
    padding: 5px 15px;
    background-color: var(--primary-color);
    color: white;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.project-detail-header h1 {
    font-size: 2.8rem;
    color: var(--text-dark);
    margin-bottom: 10px;
}

.client-info {
    font-family: var(--font-heading);
    font-style: italic;
    color: var(--text-medium);
}

.project-content-grid {
    margin-top: 40px;
}

.project-description {
    margin-bottom: 40px;
    background: white;
    padding: 30px;
    border: 1px solid #eee;
}

.project-description h3 {
    border-bottom: 1px solid #eee;
    padding-bottom: 10px;
    margin-bottom: 20px;
    font-size: 1.2rem;
    text-transform: uppercase;
}

.project-description p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #444;
}

/* Sidebar */
.sidebar-box {
    background: var(--bg-light);
    padding: 30px;
    border: 1px solid #ddd;
    margin-bottom: 30px;
}

.sidebar-box h4 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 20px;
    border-bottom: 2px solid var(--primary-color);
    padding-bottom: 10px;
    display: inline-block;
}

.sidebar-box ul li {
    font-size: 0.95rem;
    padding: 12px 0;
    border-bottom: 1px solid #e0e0e0;
    color: var(--text-medium);
}

.sidebar-box ul li strong {
    color: var(--text-dark);
    margin-right: 5px;
}

/* Footer - Simple & Sober */
.footer {
    background-color: #212529;
    /* Dark Grey/Black */
    color: #ababab;
    padding-top: 60px;
    margin-top: auto;
    font-size: 0.9rem;
}

.footer h3 {
    color: #ffffff;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 25px;
    font-weight: 600;
}

.footer-col p {
    margin-bottom: 15px;
    line-height: 1.6;
}

.footer-col i {
    width: 20px;
    color: var(--white);
    margin-right: 10px;
}

.footer-bottom {
    background-color: #1a1e21;
    border-top: 1px solid #2c3034;
    padding: 25px 0;
    margin-top: 60px;
}

.social-links a {
    color: #ababab;
    margin-right: 20px;
    font-size: 1.2rem;
}

.social-links a:hover {
    color: #ffffff;
}



/* Clients Section */
.clients-section {
    background-color: var(--white);
    text-align: center;
}

.clients-list ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 15px;
    max-width: 900px;
    margin: 0 auto;
}

.clients-list li {
    background-color: var(--bg-light);
    padding: 10px 20px;
    border-radius: 4px;
    /* Slightly rounded for list items */
    border: 1px solid #e0e0e0;
    font-size: 0.95rem;
    color: var(--text-dark);
    transition: all 0.2s ease;
}

.clients-list li:hover {
    background-color: var(--primary-color);
    color: white;
    border-color: var(--primary-color);
    transform: translateY(-2px);
}

.featured-client-logo {
    display: flex;
    justify-content: center;
    margin-top: 40px;
}

.featured-client-logo img {
    max-width: 185px; /* Refined final size for PC */
    height: auto;
    display: block;
}

.clients-logos-container {
    display: flex;
    justify-content: center;
    margin-top: 20px;
    width: 100%;
}

.client-collage-img {
    max-width: 65%;
    height: auto;
    border-radius: 4px;
    display: block;
}

/* Header - Left Logo / Right Nav Layout */
.header {
    background-color: var(--bg-white);
    border-bottom: 1px solid #e0e0e0;
    position: sticky;
    top: 0;
    z-index: 1000;
    padding: 0;
}

.header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 220px;
    /* Matched to logo height */
    padding: 0 100px;
    /* More centered, less edge-hugging */
    max-width: 100%;
    margin: 0;
    width: 100%;
}

.header-content-wrapper {
    display: none;
}

.logo-link {
    display: block;
    line-height: 0;
    position: static;
    /* No hanging */
    margin: 0;
    padding: 0;
}

.logo-img {
    height: 220px !important;
    width: auto;
    display: block;
    object-fit: contain;
}

.main-nav {
    margin: 0;
}

.nav-links {
    display: flex;
    gap: 30px;
    align-items: center;
    margin: 0;
    padding: 0;
}

.nav-links {
    display: flex;
    gap: 40px;
    align-items: center;
    margin: 0;
    padding: 0;
}

.nav-links li {
    list-style: none;
}

.nav-links a {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1rem;
    color: var(--text-dark);
    text-transform: uppercase;
    letter-spacing: 2px;
    padding-bottom: 5px;
    border-bottom: 2px solid transparent;
    transition: all 0.3s ease;
}

.nav-links a:hover {
    color: var(--primary-color);
    border-bottom: 2px solid var(--primary-color);
}

.admin-link {
    color: var(--text-light) !important;
    font-size: 0.9rem !important;
}

.admin-link:hover {
    color: var(--primary-color) !important;
}

/* Nav Toggle (Hamburger) */
.nav-toggle {
    background: none;
    border: none;
    font-size: 2rem;
    cursor: pointer;
    color: var(--primary-color);
    padding: 10px;
    z-index: 10;
}

/* Sidebar Styling */
.sidebar-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 2000;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s;
}

.sidebar-overlay.active {
    opacity: 1;
    visibility: visible;
}

.sidebar-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 280px;
    height: 100%;
    background: var(--bg-white);
    z-index: 2100;
    transform: translateX(-100%);
    transition: transform 0.3s ease;
    box-shadow: 2px 0 15px rgba(0, 0, 0, 0.2);
    display: flex;
    flex-direction: column;
}

.sidebar-nav.active {
    transform: translateX(0);
}

.close-btn {
    align-self: flex-end;
    background: none;
    border: none;
    font-size: 2.5rem;
    cursor: pointer;
    padding: 10px 20px;
    color: var(--text-medium);
    transition: color 0.3s;
}

.close-btn:hover {
    color: var(--primary-color);
}

.sidebar-content {
    padding: 20px 40px;
}

.sidebar-links li {
    margin-bottom: 30px;
    text-align: left;
}

.sidebar-links a {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--text-dark);
    text-transform: uppercase;
    letter-spacing: 2px;
    border-bottom: 1px solid transparent;
    transition: all 0.3s;
}

.sidebar-links a:hover {
    color: var(--primary-color);
    padding-left: 10px;
    border-color: var(--primary-color);
}

.sidebar-admin {
    margin-top: auto;
    margin-bottom: 40px;
    padding-top: 20px;
    border-top: 1px solid #eee;
    text-align: center;
}

.footer h3 {
    text-transform: none !important;
}

.footer-bottom {
    text-align: right !important;
    padding: 25px 100px !important;
}

@keyframes ticker {
    0% {
        transform: translateX(0);
    }

    100% {
        transform: translateX(-50%);
    }
}

.weather-widget-container:hover #weather-ticker {
    animation-play-state: paused;
}

/* Login Styles */
.login-container {
    padding: 20px;
    background: #fff;
    border: 1px solid #eee;
    margin-top: 20px;
    display: inline-block;
    width: 100%;
    max-width: 400px;
}

.login-form .form-group {
    margin-bottom: 20px;
    text-align: left;
}

.login-form label {
    display: block;
    margin-bottom: 5px;
    font-weight: 600;
    color: var(--text-dark);
}

.login-form input[type="text"],
.login-form input[type="password"] {
    width: 100%;
    padding: 10px;
    border: 1px solid #ddd;
    border-radius: 2px;
}


/* Responsive Fixes - Mobile */
@media (max-width: 768px) {

    /* Header Fixes - Override Desktop Specifics */
    .header-container {
        flex-direction: column !important;
        height: auto !important;
        padding: 20px 0 !important;
    }

    .logo-img {
        height: 90px !important;
        /* Smaller logo for mobile to prevent taking up screen */
        width: auto !important;
        margin-bottom: 15px;
    }

    .nav-links {
        display: flex;
        flex-wrap: wrap;
        /* Allow wrapping if many links */
        justify-content: center;
        gap: 15px;
        margin-top: 10px;
        width: 100%;
        text-align: center;
    }

    .nav-links a {
        font-size: 0.85rem;
        /* Slightly smaller text */
        padding: 5px;
    }

    /* Hero Fixes */
    .hero {
        height: auto;
        /* Let content dictate height + padding */
        min-height: 400px;
        padding: 80px 20px 60px 20px;
        /* Top padding ensures text clears header */
        background-position: center;
    }

    .hero-content {
        padding-top: 20px;
    }

    .hero-content h1 {
        font-size: 2rem !important;
        line-height: 1.3;
    }

    .hero-content p {
        font-size: 1rem;
        padding: 0 15px;
    }

    /* Grid Fixes */
    .services-grid,
    .projects-grid,
    .project-content-grid {
        grid-template-columns: 1fr !important;
    }

    .container {
        padding: 0 20px !important;
    }

    .clients-list ul {
        gap: 10px;
    }

    .clients-list li {
        font-size: 0.8rem;
        padding: 8px 12px;
    }

    .footer-bottom {
        padding: 30px 20px !important;
        text-align: center !important;
    }

    /* Client Logos Mobile Fix */
    .featured-client-logo {
        margin-top: 30px !important;
    }

    .featured-client-logo img {
        max-width: 85px !important; /* Refined intermediate size for mobile balance */
    }

    .clients-logos-container {
        margin-top: 15px !important;
    }

    .client-collage-img {
        max-width: 85% !important;
    }
}